
# config globale
BACKEND_PORT=3000
FRONTEND_PORT=5173
CLIENT_URL=http://localhost:5173


DB_USER=postgres
DB_PASSWORD=mot_de_passe_docker_ici
DB_NAME=portfolio_db
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}?schema=public"



# Base de Données Supabase  Local
# Remplacer par vos propres URLs de connexion
#DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?pgbouncer=true"
#DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME"

# Sécurité 
ACCESS_TOKEN_SECRET=votre_secret_access_token_ici
REFRESH_TOKEN_SECRET=votre_secret_refresh_token_ici
EMAIL_TOKEN_SECRET=votre_secret_email_token_ici

# Expiration des tokens
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# ── Configuration Email (Nodemailer / SMTP) ──
EMAIL_SERVICE=gmail
EMAIL_USER=votre_adresse_email@gmail.com
EMAIL_PASS=votre_mot_de_passe_application_google
MAIL_FROM="Credencia Support <votre_adresse_email@gmail.com>"

# SMTP generique optionnel, a utiliser au lieu de EMAIL_SERVICE si besoin.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=votre_adresse_email@gmail.com
# SMTP_PASS=votre_mot_de_passe_application_google

#Github OAuth
GITHUB_CLIENT_ID=secret_github_client_id_ici
GITHUB_CLIENT_SECRET=secret_github_oauth_ici


GITHUB_CALLBACK_URL=http://localhost:3000/api/student/github/callback

# Uploads / Object Storage
# Local dev recommande : MinIO avec driver s3.
# Production recommande : service S3-compatible manage, ou MinIO distribue.
STORAGE_DRIVER=s3
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_BUCKET_PUBLIC_READ=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=student-uploads
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/student-uploads
SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/gif,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# Alternative sans MinIO pour debug backend uniquement
# STORAGE_DRIVER=local
# LOCAL_UPLOAD_DIR=uploads
