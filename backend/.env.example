# --- GLOBAL ---
BACKEND_PORT=3000
FRONTEND_PORT=5173
CLIENT_URL=http://localhost:5173

# --- DATABASE ---
DB_USER=postgres
DB_PASSWORD=mot_de_passe_docker_ici
DB_NAME=portfolio_db

# Exemple local quand la base Docker est exposee sur localhost:5433.
DATABASE_URL="postgresql://postgres:mot_de_passe_docker_ici@localhost:5433/portfolio_db?schema=public"
DIRECT_URL="postgresql://postgres:mot_de_passe_docker_ici@localhost:5433/portfolio_db?schema=public"

# Pour une base externe, remplacez les deux lignes ci-dessus par vos URLs.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB_NAME"

# --- SECURITY ---
ACCESS_TOKEN_SECRET=votre_secret_access_token_ici
REFRESH_TOKEN_SECRET=votre_secret_refresh_token_ici
EMAIL_TOKEN_SECRET=votre_secret_email_token_ici
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# --- EMAIL ---
EMAIL_USER=votre_adresse_email@gmail.com
EMAIL_PASS=votre_mot_de_passe_application_google

# --- GITHUB OAUTH ---
GITHUB_CLIENT_ID=secret_github_client_id_ici
GITHUB_CLIENT_SECRET=secret_github_oauth_ici
GITHUB_CALLBACK_URL=http://localhost:3000/api/student/github/callback

# --- UPLOADS / STORAGE ---
# local = fichiers dans le dossier uploads du backend.
# s3 = service compatible S3 comme MinIO, AWS S3, Scaleway Object Storage...
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_MIME_TYPES=application/msword,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/gif,image/jpeg,image/png,image/webp,text/plain

# Optionnel si STORAGE_DRIVER=s3
S3_BUCKET=student-uploads
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
STORAGE_AUTO_CREATE_BUCKET=false
STORAGE_BUCKET_PUBLIC_READ=false
SIGNED_URL_TTL_SECONDS=300

# Alias MinIO optionnels si vous ne voulez pas utiliser les variables S3_*.
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=student-uploads
MINIO_PUBLIC_URL=
