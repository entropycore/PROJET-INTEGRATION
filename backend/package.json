{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "dev:docker": "prisma migrate deploy && prisma generate && node --watch src/server.js",
    "test": "jest --forceExit --detectOpenHandles --runInBand",
    "test:unit": "jest tests/unit --verbose --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test:sec": "jest tests/integration/middlewares tests/unit/middlewares --runInBand",
    "security:scan": "bash ../scripts/zap-scan.sh",
    "lint": "eslint . --quiet",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1055.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@prisma/client": "^6.19.3",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.1",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jest": "^29.0.0",
    "prettier": "^3.8.3",
    "prisma": "^6.19.3",
    "supertest": "^6.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFiles": [
      "dotenv/config"
    ]
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
