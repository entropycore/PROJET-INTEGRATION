# --- PORTS ---
BACKEND_PORT=3000
FRONTEND_PORT=5173

# --- DOCKER DATABASE ---
DB_USER=postgres
DB_PASSWORD=mot_de_passe
DB_NAME=portfolio_db
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?schema=public"

# --- SECURITY ---
ACCESS_TOKEN_SECRET=secret_pour_access_token
REFRESH_TOKEN_SECRET=secret_pour_refresh_token
EMAIL_TOKEN_SECRET=secret_pour_email_token

ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

CLIENT_URL=http://localhost:5173

# --- EMAIL ---
# Gmail: utilisez une adresse reelle + un mot de passe d'application Google.
EMAIL_SERVICE=gmail
EMAIL_USER=votre_email@gmail.com
EMAIL_PASS=votre_mot_de_passe_application_google
MAIL_FROM="Credencia Support <votre_email@gmail.com>"

# SMTP generique optionnel, a utiliser au lieu de EMAIL_SERVICE si besoin.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=votre_email@gmail.com
# SMTP_PASS=votre_mot_de_passe_application_google

# --- OBJECT STORAGE / MINIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=student-uploads
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_READ=false
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=300
UPLOAD_MAX_MB=10
