# --- PORTS ---
BACKEND_PORT=3000
FRONTEND_PORT=5173

# --- DOCKER DATABASE ---
DB_USER=postgres
DB_PASSWORD=mot_de_passe
DB_NAME=portfolio_db
DB_PORT=5433

# Pour lancer Prisma depuis la machine hote avec la base Docker exposee.
DATABASE_URL="postgresql://postgres:mot_de_passe@localhost:5433/portfolio_db?schema=public"
DIRECT_URL="postgresql://postgres:mot_de_passe@localhost:5433/portfolio_db?schema=public"

# --- SECURITY ---
ACCESS_TOKEN_SECRET=secret_pour_access_token
REFRESH_TOKEN_SECRET=secret_pour_refresh_token
EMAIL_TOKEN_SECRET=secret_pour_email_token
CSRF_SECRET=secret_pour_csrf

ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# --- EMAIL ---
EMAIL_USER=votre_email@gmail.com
EMAIL_PASS=votre_mot_de_passe_app
CLIENT_URL=http://localhost:5173

# --- UPLOADS / STORAGE ---
# MinIO est le stockage par defaut du projet.
STORAGE_DRIVER=s3
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_MIME_TYPES=application/msword,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/gif,image/jpeg,image/png,image/webp,text/plain

# --- MINIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=student-uploads
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_PUBLIC_READ=false

# --- S3 COMPATIBLE ---
# Ces valeurs sont utilisees par le backend. Docker dev remplace S3_ENDPOINT
# par http://minio:9000 pour parler au conteneur MinIO.
S3_BUCKET=student-uploads
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_BUCKET_PUBLIC_READ=false
SIGNED_URL_TTL_SECONDS=300
