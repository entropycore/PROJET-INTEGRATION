# Database Docker
DB_USER=postgres
DB_PASSWORD=change_this_strong_password
DB_NAME=portfolio_db

# Backend / Auth
NODE_ENV=production
PORT=3000
HTTPS=false
TRUST_PROXY=true

ACCESS_TOKEN_SECRET=change_this_long_random_secret
REFRESH_TOKEN_SECRET=change_this_other_long_random_secret
EMAIL_TOKEN_SECRET=change_this_email_secret

ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Frontend URL through nginx
CLIENT_URL=http://localhost

# Email
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_google_app_password
MAIL_FROM=Credencia Support <your_email@gmail.com>

# Storage - required because the seed uploads a certificate
STORAGE_DRIVER=s3
S3_BUCKET=student-uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/student-uploads
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_BUCKET_PUBLIC_READ=false

UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_MIME_TYPES=application/msword,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/gif,image/jpeg,image/png,image/webp,text/plain
SIGNED_URL_TTL_SECONDS=300
